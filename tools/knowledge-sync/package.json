{
  "name": "ai-knowledge-sync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Knowledge-source provenance and explicit pending-import tools. Fetches registered sources, records hashes and diffs, and validates locally prepared packets; it does not bundle medical text or approve documents.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "audit:corpus": "node audit-corpus.mjs",
    "test": "node --test tests/*.test.mjs",
    "intake": "node cli.mjs intake",
    "import:local": "node import-local.mjs",
    "sources": "node cli.mjs sources",
    "fetch": "node cli.mjs fetch",
    "diff": "node cli.mjs diff",
    "proposals": "node cli.mjs proposals",
    "verify": "node cli.mjs verify",
    "refs": "node cli.mjs refs",
    "citations": "node cli.mjs citations"
  },
  "dependencies": {
    "parse5": "7.3.0"
  }
}
